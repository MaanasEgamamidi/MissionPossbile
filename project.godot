; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mars Colony"
config/description="Cooperative Mars colony game. Prompt 02 state: world import and lighting rehearsal on the current map."
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

general/text_to_speech=true
driver/enable_input=true

[autoload]

PerfSettings="*res://perf/perf_settings.gd"
PerfHud="*res://perf/perf_hud.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/funplay_mcp/plugin.cfg")

[rendering]

anti_aliasing/quality/msaa_3d=2
limits/cluster_builder/max_clustered_elements=1024.0
environment/defaults/default_clear_color=Color(0.2, 0.125, 0.07, 1)
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=2.0
