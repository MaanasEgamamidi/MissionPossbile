# Large binary assets go through Git LFS (colony.glb is over GitHub's 100 MB limit)
*.glb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.res filter=lfs diff=lfs merge=lfs -text
# Godot text files keep LF
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
# Weather manifests verify byte sizes and SHA-256: checkout must preserve the authored LF bytes.
data/weather/**/*.csv text eol=lf
data/weather/**/*.json text eol=lf
tests/fixtures/**/*.csv text eol=lf
tests/fixtures/**/*.json text eol=lf
